# Node
TZ=UTC
PORT=3333
HOST=localhost
NODE_ENV=development

# App
LOG_LEVEL=info
APP_KEY=
APP_URL=http://${HOST}:${PORT}

# Session
SESSION_DRIVER=cookie

#--------------------------------------------------------------------
# CORS (configure allowed origins for API access)
#--------------------------------------------------------------------
# CORS_ORIGIN=http://localhost:9000

# Database (PostgreSQL in Docker, see docker-compose.yml)
DB_HOST=127.0.0.1
DB_PORT=5433
DB_USER=bebe
DB_PASSWORD=bebe
DB_DATABASE=bebe
